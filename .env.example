# ═══════════════════════════════════════════════════════════
# UniBot Environment Variables
# Copy this file to ".env" and fill in your real values.
# NEVER commit the real .env file to GitHub.
# ═══════════════════════════════════════════════════════════

# ── Gmail SMTP (for sending OTP emails) ──
# Create a Gmail account e.g. unibot.dkut@gmail.com
# Enable 2-Step Verification, then generate an App Password
# Leave BLANK during early development — OTP prints to console instead
EMAIL_ADDRESS=
EMAIL_PASSWORD=

# ── Twilio (for WhatsApp) ──
# From your Twilio Console after creating a free account
# Leave BLANK during early development — messages print to console instead
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── Database ──
# Leave BLANK for local development (uses SQLite automatically)
# Railway provides this automatically in production
DATABASE_URL=

# ── Redis ──
# Leave BLANK for local development (uses in-memory sessions)
# Railway provides this automatically in production
REDIS_URL=
